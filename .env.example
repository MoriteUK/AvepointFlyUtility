# Copy this file to .env and set values before deploying.
# In compose.yaml these are passed via the `environment:` section.

# Required: password to log in to the web UI
FLY_PASSWORD=change-me-to-something-strong

# Recommended: a long random string for session cookie signing
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex') |> console.log"
SESSION_SECRET=replace-with-a-long-random-string

# Port the server listens on inside the container (default 3000)
PORT=3000

# Set to 1 when running behind an HTTPS-terminating reverse proxy (e.g. nginx)
# This enables secure session cookies.
TRUST_PROXY=1
